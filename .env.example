POSTGRES_DB=ecommerce_agent
POSTGRES_USER=ecommerce_agent
POSTGRES_PASSWORD=change-me-for-local-only
DATABASE_URL=postgresql+psycopg://ecommerce_agent:change-me-for-local-only@db:5432/ecommerce_agent
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
AUTH_MODE=password
TASK_EXECUTION_MODE=inline
AUTO_CREATE_SCHEMA=true
BOOTSTRAP_ADMIN_TENANT=local
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
ACCESS_TOKEN_MINUTES=480
MARKET_MAX_PRODUCT_LIMIT=50
TAOBAO_DEMO_COLLECTION_ENABLED=false
TAOBAO_DEMO_ALLOWED_TENANTS=demo
TAOBAO_ALLOWED_HOSTS=s.taobao.com,login.taobao.com,item.taobao.com
TAOBAO_PAGE_TIMEOUT_MS=20000
TAOBAO_MIN_REQUEST_INTERVAL_MS=1000
TAOBAO_RAW_SNAPSHOT_DIR=./data/raw/market-intelligence
TAOBAO_AUTH_STATE_ENABLED=false
TAOBAO_AUTH_STATE_PATH=
TAOBAO_AUTH_STATE_HOST_PATH=C:/path/to/taobao-state.json
# JWT_SECRET=replace-with-a-secret-manager-reference
# JWT_ISSUER=https://identity.example.com/
# JWT_AUDIENCE=ecommerce-agent-api
